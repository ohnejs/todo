{
  "name": "todo",
  "version": "0.1.0",
  "private": true,
  "description": "Lists and tasks for every account, with a Today page and an AI assistant. An ohne example.",
  "homepage": "https://ohne.dev/examples/todo",
  "license": "MIT",
  "author": "Muris Ceman <muris@ohne.dev>",
  "type": "module",
  "scripts": {
    "dev": "ohne dev",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepare": "ohne prepare",
    "serve:api": "ohne serve api",
    "serve:dashboard": "ohne serve dashboard",
    "test": "ohne prepare && node --test --import ohnejs/register \"tests/**/*.test.ts\"",
    "typecheck": "tsc && tsc -p dashboard/tsconfig.json"
  },
  "dependencies": {
    "ohnejs": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.5.1"
}
